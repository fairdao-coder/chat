<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui/xaml/2006"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiChat.ViewModels"
             xmlns:models="clr-namespace:MauiChat.Models"
             x:Class="MauiChat.Views.AddFriendPage"
             x:DataType="vm:AddFriendViewModel"
             Title="Add Friend">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Incoming requests -->
        <Label Grid.Row="0" Text="Incoming requests" FontAttributes="Bold" Padding="10" />
        <CollectionView Grid.Row="1" x:Name="RequestsList"
                        ItemsSource="{Binding IncomingRequests}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FriendRequestDto">
                    <Grid ColumnDefinitions="*,Auto" Padding="10">
                        <Label Text="{Binding RequesterName}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Accept" Clicked="OnAcceptClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Search -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="10" ColumnSpacing="6">
            <Entry Grid.Column="0" Text="{Binding SearchQuery}" Placeholder="Search username / nickname" />
            <Button Grid.Column="1" Text="Search" Command="{Binding SearchCommand}" />
        </Grid>

        <Label Grid.Row="3" Text="Results" FontAttributes="Bold" Padding="10" />

        <CollectionView Grid.Row="4" x:Name="ResultsList"
                        ItemsSource="{Binding SearchResults}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:UserDto">
                    <Grid ColumnDefinitions="*,Auto" Padding="10">
                        <Label Text="{Binding NickName}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Add" Clicked="OnSendRequestClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
