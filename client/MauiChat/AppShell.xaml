<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui/xaml/2006"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MauiChat.Views"
       x:Class="MauiChat.AppShell"
       Title="微聊">

    <!-- Brand chrome -->
    <Shell.BackgroundColor>{StaticResource Primary}</Shell.BackgroundColor>
    <Shell.ForegroundColor>White</Shell.ForegroundColor>
    <Shell.TitleColor>White</Shell.TitleColor>
    <Shell.DisabledColor>#B6B6B6</Shell.DisabledColor>
    <Shell.UnselectedColor>#9A9A9A</Shell.UnselectedColor>
    <Shell.TabBarBackgroundColor>{StaticResource Panel}</Shell.TabBarBackgroundColor>
    <Shell.TabBarForegroundColor>{StaticResource Primary}</Shell.TabBarForegroundColor>
    <Shell.TabBarTitleColor>{StaticResource Primary}</Shell.TabBarTitleColor>
    <Shell.TabBarUnselectedColor>#9A9A9A</Shell.TabBarUnselectedColor>

    <TabBar>
        <Tab Title="通讯录" Route="contacts">
            <ShellContent ContentTemplate="{DataTemplate views:ContactsPage}" />
        </Tab>
    </TabBar>

</Shell>
