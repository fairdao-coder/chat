<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui/xaml/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- ===== Brand palette (matches H5 微聊) ===== -->
  <Color x:Key="Primary">#07C160</Color>
  <Color x:Key="PrimaryDark">#06AD56</Color>
  <Color x:Key="Bg">#EDEDED</Color>
  <Color x:Key="ChatBg">#F5F5F5</Color>
  <Color x:Key="Panel">#F7F7F7</Color>
  <Color x:Key="White">#FFFFFF</Color>
  <Color x:Key="Text">#181818</Color>
  <Color x:Key="Text2">#4C4C4C</Color>
  <Color x:Key="Muted">#9A9A9A</Color>
  <Color x:Key="Border">#E6E6E6</Color>
  <Color x:Key="Divider">#F0F0F0</Color>
  <Color x:Key="BubbleMine">#95EC69</Color>
  <Color x:Key="BubbleOther">#FFFFFF</Color>
  <Color x:Key="Danger">#FA5151</Color>
  <Color x:Key="Link">#576B95</Color>

  <!-- ===== Implicit styles ===== -->
  <Style TargetType="Label" ApplyToDerivedTypes="True">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
    <Setter Property="TextColor" Value="White" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="HeightRequest" Value="44" />
  </Style>

  <Style TargetType="Entry">
    <Setter Property="BackgroundColor" Value="White" />
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style TargetType="SearchBar">
    <Setter Property="BackgroundColor" Value="{StaticResource Panel}" />
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
    <Setter Property="CancelButtonColor" Value="{StaticResource Muted}" />
  </Style>

  <Style TargetType="Frame">
    <Setter Property="BackgroundColor" Value="White" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HasShadow" Value="False" />
    <Setter Property="BorderColor" Value="{StaticResource Border}" />
  </Style>

  <Style TargetType="RefreshView">
    <Setter Property="BackgroundColor" Value="Transparent" />
  </Style>

  <Style TargetType="ActivityIndicator">
    <Setter Property="Color" Value="{StaticResource Primary}" />
  </Style>

</ResourceDictionary>
