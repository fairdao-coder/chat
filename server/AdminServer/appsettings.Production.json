{
  "ConnectionStrings": {
    "Default": "User ID=<prod_user>;Password=<prod_password>;Host=<prod_db_host>;Database=chatdb;Pooling=true;"
  },
  "Jwt": {
    "Key": "<CHANGE-ME: use a strong 64+ char secret, prefer env var Jwt__Key>",
    "Issuer": "AdminServer",
    "Audience": "AdminClient"
  },
  "Urls": "http://0.0.0.0:5299",
  "SeedAdmin": {
    "UserName": "admin",
    "Password": "<CHANGE-ME: set a strong admin password, prefer env var SeedAdmin__Password>"
  },
  "Cors": {
    "Origins": [
      "https://servestatic.github.io",
      "https://<your-production-domain>"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
